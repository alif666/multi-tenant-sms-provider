{
  "info": {
    "name": "Studio Butterfly SMS Admin and Dummy Provider Demo",
    "description": "CSRF/JWT authentication, temporary admin registration, tenant provider assignment, retry, failover, cost recording, and runtime gateway inspection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminUsername", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "ChangeMe-Postman-Admin-25!" },
    { "key": "jwt", "value": "" },
    { "key": "csrfToken", "value": "" },
    { "key": "tenantA", "value": "00000000-0000-0000-0000-000000000001" },
    { "key": "tenantB", "value": "00000000-0000-0000-0000-000000000002" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const csrf = pm.collectionVariables.get('csrfToken');",
          "if (csrf && pm.request.method !== 'GET' && pm.request.method !== 'HEAD') {",
          "  pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: csrf });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0. Get CSRF token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/csrf-token/public"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('csrfToken', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "1. Register temporary ROLE_ADMIN",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "2. Login and save JWT",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.collectionVariables.set('jwt', body.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Create tenant A",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{tenantA}}\",\n  \"name\": \"Postman Tenant A\"\n}"
        },
        "url": "{{baseUrl}}/api/admin/tenants"
      }
    },
    {
      "name": "4. Assign tenant A to VONAGE (admin endpoint)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"provider\": \"VONAGE\"\n}" },
        "url": "{{baseUrl}}/api/admin/tenants/{{tenantA}}/provider"
      }
    },
    {
      "name": "5. Observe all runtime gateway beans",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:18081/demo/gateways"
      }
    },
    {
      "name": "6. Inspect runtime gateway beans",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/demo/gateways"
      }
    },
    {
      "name": "7. Reset local demo state",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/demo/reset"
      }
    },
    {
      "name": "8. Assign tenant A through demo compatibility endpoint",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"provider\": \"VONAGE\"\n}" },
        "url": "{{baseUrl}}/demo/tenants/{{tenantA}}/provider"
      }
    },
    {
      "name": "9. Send using tenant provider",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{tenantA}}\",\n  \"to\": \"+4915112345678\",\n  \"body\": \"Tenant-specific provider test\",\n  \"referenceId\": \"postman-tenant-routing-1\"\n}" },
        "url": "{{baseUrl}}/demo/messages"
      }
    },
    {
      "name": "10. Configure TWILIO to fail once",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"mode\": \"TRANSIENT_FAILURE\",\n  \"failuresBeforeSuccess\": 1,\n  \"segmentCount\": 1\n}" },
        "url": "{{baseUrl}}/demo/providers/TWILIO/behavior"
      }
    },
    {
      "name": "11. Send and observe retry",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{tenantB}}\",\n  \"to\": \"+4915112345678\",\n  \"body\": \"Retry test\",\n  \"referenceId\": \"postman-retry-1\"\n}" },
        "url": "{{baseUrl}}/demo/messages"
      }
    },
    {
      "name": "12. Configure TWILIO to fail and force failover",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"mode\": \"TRANSIENT_FAILURE\",\n  \"failuresBeforeSuccess\": 5,\n  \"segmentCount\": 1\n}" },
        "url": "{{baseUrl}}/demo/providers/TWILIO/behavior"
      }
    },
    {
      "name": "13. Send and observe VONAGE failover",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{tenantB}}\",\n  \"to\": \"+4915112345678\",\n  \"body\": \"Failover test\",\n  \"referenceId\": \"postman-failover-1\"\n}" },
        "url": "{{baseUrl}}/demo/messages"
      }
    },
    {
      "name": "14. Configure a three-segment success",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"mode\": \"SUCCESS\",\n  \"failuresBeforeSuccess\": 0,\n  \"segmentCount\": 3\n}" },
        "url": "{{baseUrl}}/demo/providers/TWILIO/behavior"
      }
    },
    {
      "name": "15. Send and observe multi-segment cost",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{tenantB}}\",\n  \"to\": \"+4915112345678\",\n  \"body\": \"Three segment cost test\",\n  \"referenceId\": \"postman-cost-3-segments\"\n}" },
        "url": "{{baseUrl}}/demo/messages"
      }
    },
    {
      "name": "16. Read tenant B costs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/demo/costs/{{tenantB}}"
      }
    },
    {
      "name": "17. Invalid phone number",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{tenantA}}\",\n  \"to\": \"not-a-phone-number\",\n  \"body\": \"Validation test\",\n  \"referenceId\": \"postman-invalid-phone\"\n}" },
        "url": "{{baseUrl}}/demo/messages"
      }
    },
    {
      "name": "18. Unknown tenant provider (admin endpoint)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"provider\": \"UNKNOWN_PROVIDER\"\n}" },
        "url": "{{baseUrl}}/api/admin/tenants/{{tenantA}}/provider"
      }
    },
    {
      "name": "19. Send with unavailable provider",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"tenantId\": \"{{tenantA}}\",\n  \"to\": \"+4915112345678\",\n  \"body\": \"Missing gateway test\",\n  \"referenceId\": \"postman-missing-gateway\"\n}" },
        "url": "{{baseUrl}}/demo/messages"
      }
    }
  ]
}
